#!/usr/bin/env python3
"""Readable local ccusage reports. No third-party Python packages required."""
import argparse
import math
import tempfile
from pathlib import Path
from contextlib import contextmanager
import datetime as dt
import json
import os
import queue
import threading
import signal
import shutil
import subprocess
import sys
import time
from collections import defaultdict


@contextmanager
def refresh_lock(stream):
    """Nonblocking process lock; released by the OS even after a crash."""
    acquired = False
    if os.name == 'nt':
        import msvcrt
        stream.seek(0, os.SEEK_END)
        if stream.tell() == 0:
            stream.write(b'0')
            stream.flush()
        stream.seek(0)
        try:
            msvcrt.locking(stream.fileno(), msvcrt.LK_NBLCK, 1)
            acquired = True
        except OSError:
            pass
        try:
            yield acquired
        finally:
            if acquired:
                stream.seek(0)
                msvcrt.locking(stream.fileno(), msvcrt.LK_UNLCK, 1)
    else:
        import fcntl
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except BlockingIOError:
            pass
        try:
            yield acquired
        finally:
            if acquired:
                fcntl.flock(stream, fcntl.LOCK_UN)


class WindowsJob:
    """Kill-on-close job containing a gated launcher and all its descendants."""
    def __init__(self, process):
        import ctypes
        from ctypes import wintypes as w
        class Basic(ctypes.Structure):
            _fields_ = [('process_time', ctypes.c_longlong), ('job_time', ctypes.c_longlong),
                        ('flags', w.DWORD), ('min_ws', ctypes.c_size_t), ('max_ws', ctypes.c_size_t),
                        ('active', w.DWORD), ('affinity', ctypes.c_size_t), ('priority', w.DWORD), ('scheduling', w.DWORD)]
        class IO(ctypes.Structure):
            _fields_ = [(name, ctypes.c_ulonglong) for name in ('read_ops', 'write_ops', 'other_ops', 'read_bytes', 'write_bytes', 'other_bytes')]
        class Extended(ctypes.Structure):
            _fields_ = [('basic', Basic), ('io', IO), ('process_memory', ctypes.c_size_t),
                        ('job_memory', ctypes.c_size_t), ('peak_process', ctypes.c_size_t), ('peak_job', ctypes.c_size_t)]
        self.api = ctypes.WinDLL('kernel32', use_last_error=True)
        for name, args, result in [
            ('CreateJobObjectW', [ctypes.c_void_p, w.LPCWSTR], w.HANDLE),
            ('SetInformationJobObject', [w.HANDLE, ctypes.c_int, ctypes.c_void_p, w.DWORD], w.BOOL),
            ('OpenProcess', [w.DWORD, w.BOOL, w.DWORD], w.HANDLE),
            ('AssignProcessToJobObject', [w.HANDLE, w.HANDLE], w.BOOL),
            ('CloseHandle', [w.HANDLE], w.BOOL),
        ]:
            fn = getattr(self.api, name)
            fn.argtypes, fn.restype = args, result
        self.handle = self.api.CreateJobObjectW(None, None)
        if not self.handle:
            raise ctypes.WinError(ctypes.get_last_error())
        try:
            info = Extended()
            info.basic.flags = 0x2000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
            if not self.api.SetInformationJobObject(self.handle, 9, ctypes.byref(info), ctypes.sizeof(info)):
                raise ctypes.WinError(ctypes.get_last_error())
            handle = self.api.OpenProcess(0x0100 | 0x0001, False, process.pid)
            if not handle:
                raise ctypes.WinError(ctypes.get_last_error())
            try:
                if not self.api.AssignProcessToJobObject(self.handle, handle):
                    raise ctypes.WinError(ctypes.get_last_error())
            finally:
                self.api.CloseHandle(handle)
        except BaseException:
            self.close()
            raise

    def close(self):
        if self.handle:
            self.api.CloseHandle(self.handle)
            self.handle = None


def run_report(command, timeout=180, output_limit=32 * 1024 * 1024):
    """Bound capture on every OS; clean up all owned descendants on exit."""
    windows = os.name == 'nt'
    actual = command
    if windows:
        # Gate the launcher until assignment to a job, closing the child-spawn race.
        bootstrap = 'import subprocess,sys; sys.stdin.buffer.read(1); sys.exit(subprocess.call(sys.argv[1:], stdin=subprocess.DEVNULL))'
        actual = [sys.executable, '-c', bootstrap] + command
    with subprocess.Popen(actual, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          stdin=subprocess.PIPE if windows else subprocess.DEVNULL,
                          start_new_session=not windows) as process:
        job = None
        stop = threading.Event()
        messages = queue.Queue(maxsize=8)
        readers = []
        def read_pipe(stream, name):
            try:
                while not stop.is_set():
                    chunk = os.read(stream.fileno(), 65536)
                    while not stop.is_set():
                        try:
                            messages.put((name, chunk), timeout=.1)
                            break
                        except queue.Full:
                            pass
                    if not chunk:
                        break
            except OSError:
                pass
        try:
            if windows:
                job = WindowsJob(process)
                process.stdin.write(b'1')
                process.stdin.flush()
                process.stdin.close()
            for name, stream in [('stdout', process.stdout), ('stderr', process.stderr)]:
                reader = threading.Thread(target=read_pipe, args=(stream, name), daemon=True)
                reader.start()
                readers.append(reader)
            chunks = {'stdout': bytearray(), 'stderr': bytearray()}
            size, eof = 0, set()
            deadline = time.monotonic() + timeout
            while len(eof) < 2:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(command, timeout)
                try:
                    name, chunk = messages.get(timeout=min(remaining, .1))
                except queue.Empty:
                    continue
                if not chunk:
                    eof.add(name)
                    continue
                size += len(chunk)
                if size > output_limit:
                    raise RuntimeError(f'Command output exceeded the {output_limit:,}-byte safety limit; use a shorter date range.')
                chunks[name].extend(chunk)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(command, timeout)
            code = process.wait(timeout=remaining)
            return subprocess.CompletedProcess(command, code,
                chunks['stdout'].decode('utf-8', errors='replace'),
                chunks['stderr'].decode('utf-8', errors='replace'))
        finally:
            stop.set()
            if job is not None:
                job.close()
            elif windows:
                process.kill()  # Job assignment failed; the gate never opened.
            else:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            process.wait()
            for reader in readers:
                reader.join(timeout=1)


def ccusage_command():
    executable = shutil.which('ccusage')
    if not executable:
        raise RuntimeError('ccusage not found on PATH. Install it with: npm install -g ccusage')
    if os.name == 'nt' and Path(executable).suffix.lower() in ('.cmd', '.bat', '.ps1'):
        # Run npm's JS entry through node directly, avoiding cmd.exe argument parsing.
        entry = Path(executable).parent / 'node_modules' / 'ccusage' / 'src' / 'cli.js'
        node = shutil.which('node')
        if not entry.is_file() or not node:
            raise RuntimeError('Cannot find the ccusage npm entry. Reinstall with: npm install -g ccusage')
        return [node, str(entry)]
    return [executable]


def exit_on_signal(signum, frame):
    # Raising unwinds run_report's finally block before the wrapper exits.
    raise SystemExit(128 + signum)


def add_codex_model_costs(data, command):
    """Use ccusage's own priced breakdown; only merge matching daily snapshots."""
    # Unified reports include per-model costs; focused Codex reports include reasoning.
    source_index = command.index('codex')
    pricing_command = command[:source_index] + command[source_index + 1:] + ['--by-agent']
    result = run_report(pricing_command)
    if result.returncode:
        raise RuntimeError('Could not load ccusage model pricing: ' + result.stderr.strip())
    priced = json.loads(result.stdout)
    priced_days = {}
    for day in priced.get('daily', []):
        for agent in day.get('agents', []):
            if agent.get('agent') == 'codex':
                priced_days[day['period']] = agent
    keys = ['inputTokens', 'outputTokens', 'cacheReadTokens', 'cacheCreationTokens']
    complete = True
    for day in data.get('daily', []):
        match = priced_days.get(day.get('date'))
        if match is None or abs(match.get('totalCost', -1) - day.get('costUSD', -2)) > 1e-8:
            complete = False
            continue
        breakdown = {item['modelName']: item for item in match.get('modelBreakdowns', [])}
        for name, item in day.get('models', {}).items():
            price = breakdown.get(name)
            if (price is None or any(price.get(k, 0) != item.get(k, 0) for k in keys)
                    or price.get('missingPricing') or item.get('missingPricing')
                    or 'cost' not in price):
                complete = False
                continue
            item['cost'] = price['cost']
    return complete


# Price catalogs are downloaded only at invocation time, never by a daemon.
PRICE_INTERVAL = 7 * 86400
RETRY_INTERVAL = 6 * 3600
PRICE_URLS = {
    'litellm': 'https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json',
    'models.dev': 'https://models.dev/api.json',
}


def valid_rate(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0


def catalog_prices(source, data):
    prices = {}
    if not isinstance(data, dict):
        raise ValueError('Invalid catalog')
    if source == 'litellm':
        fields = {
            'input_cost_per_token': 'inputCostPerToken',
            'output_cost_per_token': 'outputCostPerToken',
            'cache_read_input_token_cost': 'cacheReadInputTokenCost',
            'cache_creation_input_token_cost': 'cacheCreationInputTokenCost',
            'input_cost_per_token_above_200k_tokens': 'inputCostPerTokenAbove200kTokens',
            'output_cost_per_token_above_200k_tokens': 'outputCostPerTokenAbove200kTokens',
            'cache_read_input_token_cost_above_200k_tokens': 'cacheReadInputTokenCostAbove200kTokens',
            'cache_creation_input_token_cost_above_200k_tokens': 'cacheCreationInputTokenCostAbove200kTokens',
        }
        for name, entry in data.items():
            if not isinstance(entry, dict):
                continue
            item = {dest: entry[key] for key, dest in fields.items() if valid_rate(entry.get(key))}
            if 'inputCostPerToken' in item and 'outputCostPerToken' in item:
                prices[name] = item
    else:
        for provider, entry in data.items():
            if not isinstance(entry, dict):
                continue
            for name, model in entry.get('models', {}).items():
                cost = model.get('cost', {})
                item = {dest: cost[key] / 1_000_000 for key, dest in {
                    'input': 'inputCostPerToken', 'output': 'outputCostPerToken',
                    'cache_read': 'cacheReadInputTokenCost', 'cache_write': 'cacheCreationInputTokenCost',
                }.items() if valid_rate(cost.get(key))}
                if 'inputCostPerToken' in item and 'outputCostPerToken' in item:
                    prices[provider + '/' + name] = item
                    if provider in ('openai', 'anthropic', 'google', 'deepseek', 'moonshotai'):
                        prices.setdefault(name, item)
    # Keep ccusage's timestamp-dependent DeepSeek v4 schedules intact.
    return {name: item for name, item in prices.items() if 'deepseek-v4' not in name.lower()}


def cached_pricing(force=False, offline=False, cache_dir=None):
    directory = cache_dir or Path.home() / '.cache' / 'usage'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    state_path = directory / 'pricing.json'
    def load():
        try:
            value = json.loads(state_path.read_text(encoding='utf-8'))
            return value if isinstance(value, dict) and isinstance(value.get('sources', {}), dict) else {}
        except (OSError, ValueError):
            return {}
    state = load()
    sources = state.setdefault('sources', {})
    if not offline:
        # All invocations use the same lock inode; stale files do not hold locks.
        with (directory / 'refresh.lock').open('a+b') as lock, refresh_lock(lock) as acquired:
            if acquired:
                state = load()
                sources = state.setdefault('sources', {})
                changed = False
                for name, url in PRICE_URLS.items():
                    entry = sources.setdefault(name, {})
                    now = time.time()
                    updated = entry.get('updated_at', 0)
                    attempted = entry.get('attempted_at', 0)
                    fresh = 0 <= now - updated < PRICE_INTERVAL
                    cooldown = 0 <= now - attempted < RETRY_INTERVAL
                    if not force and (fresh or cooldown):
                        continue
                    entry['attempted_at'] = now
                    changed = True
                    try:
                        curl = shutil.which('curl')
                        if not curl:
                            raise RuntimeError('curl not found')
                        limit = 15 if force else 3
                        urls = ([
                            'https://cdn.jsdelivr.net/gh/BerriAI/litellm@main/model_prices_and_context_window.json',
                            url,
                        ] if name == 'litellm' else [url])
                        last_error = None
                        for download_url in urls:
                            try:
                                result = run_report([curl, '-fsSL', '--compressed', '--connect-timeout',
                                                     '5' if force else '2', '--max-time', str(limit), download_url],
                                                    timeout=limit + 1, output_limit=20 * 1024 * 1024)
                                if result.returncode:
                                    reason = {6: 'DNS lookup failed', 7: 'connection failed',
                                              22: 'HTTP request rejected', 28: f'download timed out after {limit}s',
                                              35: 'TLS connection failed', 60: 'TLS certificate validation failed'}.get(
                                                  result.returncode, f'curl exited with code {result.returncode}')
                                    raise RuntimeError(reason)
                                prices = catalog_prices(name, json.loads(result.stdout))
                                if not prices:
                                    raise ValueError('Empty catalog')
                                break
                            except (OSError, ValueError, TypeError, AttributeError, RuntimeError, subprocess.TimeoutExpired) as error:
                                last_error = error
                        else:
                            raise last_error
                        entry.update(prices=prices, updated_at=time.time())
                    except (OSError, ValueError, TypeError, AttributeError, RuntimeError, subprocess.TimeoutExpired) as error:
                        reason = 'pricing data is invalid' if isinstance(error, (ValueError, TypeError, AttributeError)) else str(error)
                        fallback = 'keeping cached prices' if entry.get('prices') else 'using other cached / built-in prices'
                        print(f'Note: {name} pricing refresh failed ({reason}); {fallback}.', file=sys.stderr)
                if changed:
                    fd, temporary = tempfile.mkstemp(prefix='.pricing-', dir=str(directory))
                    try:
                        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
                            json.dump(state, stream, allow_nan=False)
                        os.replace(temporary, state_path)
                    finally:
                        if os.path.exists(temporary):
                            os.unlink(temporary)
    prices = {}
    for name in ('models.dev', 'litellm'):
        for model, item in sources.get(name, {}).get('prices', {}).items():
            # Revalidate persisted data before handing it to ccusage.
            if isinstance(item, dict) and all(valid_rate(v) for v in item.values()):
                prices[model] = item
    dates = [entry['updated_at'] for entry in sources.values() if entry.get('updated_at')]
    status = 'cached' if prices else 'built-in'
    if dates:
        status += ' · refreshed ' + dt.datetime.fromtimestamp(min(dates)).strftime('%Y-%m-%d')
    return prices, status


@contextmanager
def pricing_config(prices):
    """Preserve discovered ccusage settings and explicit user price overrides."""
    if not prices:
        yield None
        return
    paths = [Path.cwd() / '.ccusage' / 'ccusage.json']
    configured = os.environ.get('CLAUDE_CONFIG_DIR')
    folders = [Path(p.strip()) for p in configured.split(',') if p.strip()] if configured is not None else [Path.home() / '.config' / 'claude', Path.home() / '.claude']
    paths += [folder / 'ccusage.json' for folder in folders]
    config = {}
    for path in paths:
        try:
            candidate = json.loads(path.read_text(encoding='utf-8'))
            if isinstance(candidate, dict):
                config = candidate
                break
        except (OSError, ValueError):
            pass
    defaults = config.setdefault('defaults', {})
    # Explicit user overrides retain priority over automatically downloaded rates.
    merged = {name: dict(item) for name, item in prices.items()}
    for name, item in defaults.get('pricingOverrides', {}).items():
        merged.setdefault(name, {}).update(item)
    defaults['pricingOverrides'] = merged
    with tempfile.TemporaryDirectory(prefix='usage-') as directory:
        path = Path(directory) / 'ccusage.json'
        path.write_text(json.dumps(config), encoding='utf-8')
        yield str(path)


def main():
    parser = argparse.ArgumentParser(description='Readable token usage, with complete numbers.',
        epilog='week = last 7 days; month = last 30 days; both include today. Reasoning is part of output, not added again.')
    parser.add_argument('period', nargs='?', default='today', choices=['today', 'week', 'month', 'all'])
    parser.add_argument('--days', '-days', '-d', type=int, help='Custom number of days, including today')
    parser.add_argument('--since', type=dt.date.fromisoformat, help='Start date: YYYY-MM-DD')
    parser.add_argument('--until', type=dt.date.fromisoformat, help='End date: YYYY-MM-DD')
    parser.add_argument('--source', default='codex', choices=['codex', 'claude', 'all'], help='Default: codex')
    parser.add_argument('--daily', action='store_true', help='Include a compact summary for each day')
    parser.add_argument('--models', action='store_true', help='Include token totals per model')
    parser.add_argument('--details', '-v', action='store_true', help='Show daily and model details, including input, output, reasoning and cache')
    network = parser.add_mutually_exclusive_group()
    network.add_argument('--online', '--fresh', action='store_true', help='Force a pricing refresh now')
    network.add_argument('--offline', action='store_true', help='Skip automatic pricing refresh')
    parser.add_argument('--json', action='store_true', help='Return original ccusage JSON')
    args = parser.parse_args()
    if args.days is not None and args.days < 1:
        parser.error('--days must be at least 1')
    if args.days is not None and (args.since or args.until):
        parser.error('--days cannot be combined with --since/--until')
    today = dt.date.today()
    end = args.until or today
    days = args.days if args.days is not None else {'today': 1, 'week': 7, 'month': 30, 'all': None}[args.period]
    try:
        start = args.since or (end - dt.timedelta(days=days - 1) if days else None)
    except OverflowError:
        parser.error('Date range is too large')
    if start and start > end:
        parser.error('--since must not be after --until')
    try:
        prefix = ccusage_command()
    except RuntimeError as error:
        parser.exit(1, f'Error: {error}\n')
    command = prefix + ([] if args.source == 'all' else [args.source]) + ['daily', '--json', '--until', end.strftime('%Y%m%d')]
    if start:
        command += ['--since', start.strftime('%Y%m%d')]
    pricing_status = 'built-in'
    try:
        prices, pricing_status = cached_pricing(force=args.online, offline=args.offline)
    except (OSError, ValueError, TypeError, AttributeError) as error:
        prices = {}
        print(f'Note: pricing cache unavailable; using built-in prices: {error}', file=sys.stderr)
    command += ['--offline']
    config_context = pricing_config(prices)
    try:
        # Keep the temporary config alive for both report calls; finally removes it.
        with config_context as config_path:
            if config_path:
                command += ['--config', config_path]
            result = run_report(command)
            if result.returncode == 0 and args.source == 'codex' and args.details and not args.json:
                try:
                    parsed = json.loads(result.stdout)
                    if not add_codex_model_costs(parsed, command):
                        print('Note: some model costs unavailable; rerun to refresh.', file=sys.stderr)
                    result.stdout = json.dumps(parsed)
                except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
                    print(f'Note: model cost lookup failed: {error}', file=sys.stderr)
    except subprocess.TimeoutExpired:
        parser.exit(1, 'Error: ccusage timed out after 180 seconds.\n')
    except (OSError, RuntimeError) as error:
        parser.exit(1, f'Error: {error}\n')
    if result.stderr.strip():
        print(result.stderr.strip(), file=sys.stderr)
    if result.returncode:
        parser.exit(result.returncode, result.stdout)
    try:
        data = json.loads(result.stdout)
    except ValueError:
        parser.exit(1, 'Error: ccusage returned invalid JSON.\n' + result.stdout)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    totals = data.get('totals', data.get('summary', {}))
    rows = data.get('daily', data.get('data', []))
    color = sys.stdout.isatty() and 'NO_COLOR' not in os.environ
    def heading(text):
        print(('\033[1;36m' + text + '\033[0m') if color else text)
    def number(value):
        return format(value, ',') if isinstance(value, (int, float)) else 'N/A'
    def metric(label, value):
        print(f'  {label:<19} {value}')
    def cost(row):
        value = row.get('totalCost', row.get('costUSD', row.get('totalCostUSD', row.get('cost'))))
        return f'${value:,.4f}' if value is not None else 'N/A'
    token_keys = ['inputTokens', 'outputTokens', 'cacheReadTokens', 'cacheCreationTokens']
    def model_entries(row):
        entries = row.get('models', {})
        if isinstance(entries, dict) and entries:
            return entries
        return {item['modelName']: item for item in row.get('modelBreakdowns', [])}
    def detail(row):
        for label, key in [('Input', 'inputTokens'), ('Output', 'outputTokens'),
                           ('  incl. reasoning', 'reasoningOutputTokens'),
                           ('Cache read', 'cacheReadTokens'), ('Cache create', 'cacheCreationTokens')]:
            if key in row:
                print(f'    {label:<19} {number(row[key])}')
    print()
    heading('TOKEN USAGE · ' + args.source.upper())
    print(f'  {start.isoformat() if start else "All history"} → {end.isoformat()}')
    print('  Pricing: ' + pricing_status)
    print()
    if not rows:
        print('  No usage recorded for this period.\n')
        return
    metric('Input', number(totals.get('inputTokens', totals.get('totalInputTokens'))))
    metric('Output', number(totals.get('outputTokens', totals.get('totalOutputTokens'))))
    if 'reasoningOutputTokens' in totals:
        metric('  incl. reasoning', number(totals['reasoningOutputTokens']))
    metric('Cache read', number(totals.get('cacheReadTokens', totals.get('totalCacheReadTokens'))))
    metric('Cache create', number(totals.get('cacheCreationTokens', totals.get('totalCacheCreationTokens'))))
    print()
    metric('Total tokens', number(totals.get('totalTokens')))
    metric('Estimated cost', cost(totals))
    print()
    if totals.get('unpricedModels'):
        print('  Unpriced models: ' + ', '.join(totals['unpricedModels']))
        print('  Estimated cost may be incomplete.\n')
    if args.daily or args.details:
        heading('DAILY BREAKDOWN')
        for row in sorted(rows, key=lambda r: r.get('date', r.get('period', '')), reverse=True):
            print('  ' + row.get('date', row.get('period', '?')))
            print(f'    Tokens {number(row.get("totalTokens"))} · Cost {cost(row)}')
            if args.details:
                detail(row)
                names = sorted(model_entries(row))
                if names:
                    print('    Models: ' + ', '.join(names))
                print()
        print()
    if args.models or args.details:
        heading('MODELS')
        models = defaultdict(lambda: defaultdict(int))
        for row in rows:
            for name, item in model_entries(row).items():
                models[name]['tokens'] += item.get('totalTokens', sum(item.get(k, 0) for k in token_keys))
                for key in token_keys + ['reasoningOutputTokens']:
                    if key in item:
                        models[name][key] += item[key]
                value = item.get('cost', item.get('costUSD'))
                if value is not None and not item.get('missingPricing'):
                    models[name]['cost'] += value
                else:
                    models[name]['incompleteCost'] = True
        for name, item in sorted(models.items(), key=lambda pair: pair[1]['tokens'], reverse=True):
            print(f'  {name}\n    Tokens {number(item["tokens"])}')
            if args.details:
                detail(item)
                print('    Estimated cost: ' + ('N/A' if item.get('incompleteCost') else cost(item)))
                print()
        print()


if __name__ == '__main__':
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, 'reconfigure'):
            stream.reconfigure(encoding='utf-8', errors='replace')
    signal.signal(signal.SIGTERM, exit_on_signal)
    if hasattr(signal, 'SIGHUP'):
        signal.signal(signal.SIGHUP, exit_on_signal)
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
